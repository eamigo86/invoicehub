# Copy to .env for host-side commands (pytest, migrate, runserver).
# Throwaway local development values only.
SECRET_KEY=local-dev-only-not-a-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Host-side commands connect as the migrator role on the Compose Postgres port.
DATABASE_URL=postgres://invoicehub_migrator:migrator-dev-pw@localhost:5442/invoicehub
DATABASE_APP_ROLE=invoicehub_app
CELERY_BROKER_URL=redis://localhost:6390/0
EMAIL_URL=smtp://localhost:1025
